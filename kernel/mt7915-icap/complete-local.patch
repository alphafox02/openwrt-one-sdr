+/* openwrt-one-sdr: FLEXIBLE raw RF_TEST sender to find+drive the iCap capture
+ * command. We hold a raw command-body buffer we fill byte-by-byte from userspace,
+ * then fire it as MCU_EXT_CMD(RF_TEST). This lets us experiment with the exact
+ * func_idx and iCap param layout (band/opmode/bw/antenna) that triggers the WM's
+ * icapSpectrumInit, since the func_idx->handler map is runtime-registered.
+ * u64 val opcode in [63:56]:
+ *   0x00  clear the buffer (and set default len 88)
+ *   0x01  set byte: [31:16]=offset  [7:0]=value
+ *   0x02  set send length: [15:0]=len
+ *   0x10  send a bare RF_OPER_ICAP switch (op_mode=RF_OPER_ICAP)
+ *   0x11  send a bare RF_OPER_WIFI_SPECTRUM switch
+ *   0xFF  FIRE: send the raw buffer as the RF_TEST body (len bytes)
+ * Buffer layout (struct mt7915_tm_rf_test): action@0 icap_len@1 rsv@2-3
+ *   func_idx@4-7  param@8-87. */
+static u8 icap_buf[128];
+static u32 icap_len_g = 88;
+
+int mt7915_tm_icap_prime(struct mt7915_dev *dev, u64 val)
+{
+	u32 op = (val >> 56) & 0xff;
+	int ret;
+
+	switch (op) {
+	case 0x00:
+		memset(icap_buf, 0, sizeof(icap_buf));
+		icap_len_g = 88;
+		return 0;
+	case 0x01: {
+		u32 off = (val >> 16) & 0xffff;
+		if (off < sizeof(icap_buf))
+			icap_buf[off] = val & 0xff;
+		return 0;
+	}
+	case 0x02:
+		icap_len_g = val & 0xffff;
+		if (icap_len_g > sizeof(icap_buf))
+			icap_len_g = sizeof(icap_buf);
+		return 0;
+	case 0x10:
+	case 0x11: {
+		struct mt7915_tm_rf_test req = {
+			.op.op_mode = cpu_to_le32(op == 0x10 ? RF_OPER_ICAP :
+						  RF_OPER_WIFI_SPECTRUM),
+		};
+		ret = mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(RF_TEST), &req,
+					sizeof(req), true);
+		dev_info(dev->mt76.dev, "icap: op_mode switch op=0x%x ret=%d\n", op, ret);
+		return ret;
+	}
+	case 0xff:	/* fire buf as MCU_EXT_CMD(RF_TEST=4) = BirriaSDR ext() */
+		ret = mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(RF_TEST), icap_buf,
+					icap_len_g, false);
+		dev_info(dev->mt76.dev,
+			 "icap: EXT4 len=%u [0..11]=%*ph ret=%d\n",
+			 icap_len_g, 12, icap_buf, ret);
+		return ret;
+	case 0x14: /* MT7981 native ICAP/SPECTRUM extended command 0x56 */
+		ret = mt76_mcu_send_msg(&dev->mt76, 0x56ed, icap_buf,
+					icap_len_g, false);
+		/* Serial console printk can block this CPU for milliseconds just
+		 * as IQ starts. Keep the streaming trigger free of console I/O. */
+		if (ret || get_unaligned_le32(icap_buf) != 6)
+			dev_info(dev->mt76.dev, "icap: EXT56 len=%u ret=%d\n",
+				 icap_len_g, ret);
+		return ret;
+	case 0x13:	/* fire buf as MCU_CE_CMD(1) = BirriaSDR ce(); raw cmd word
+			 * = __MCU_CMD_FIELD_CE(1<<18) | CID 1 = 0x40001 */
+		ret = mt76_mcu_send_msg(&dev->mt76, 0x40001, icap_buf,
+					icap_len_g, false);
+		dev_info(dev->mt76.dev,
+			 "icap: CE1 len=%u [0..11]=%*ph ret=%d\n",
+			 icap_len_g, 12, icap_buf, ret);
+		return ret;
+	default:
+		dev_info(dev->mt76.dev, "icap: unknown op 0x%x\n", op);
+		return -EINVAL;
+	}
+}
